# Webling-Zugang für den MCP-Server.
# WICHTIG: Eigener API-Key mit NUR Lese-Rechten (nicht der Bot-Key!)
# Anlegen in Webling: Administration -> API -> Neuer API-Key -> nur Lesen
WEBLING_BASE_URL=https://verein.webling.eu/api/1
WEBLING_MCP_API_KEY=hier-den-readonly-key-eintragen

# Optional: Ausgabeverzeichnis für lokale Namenslisten (Default: <Repo>/output)
# WEBLING_MCP_OUTPUT_DIR=

# Phase C (Chat-App auf dem VPS)
ANTHROPIC_API_KEY=sk-ant-...
WEBLING_CHAT_MODELL=claude-sonnet-5
# WEBLING_CHAT_COOKIE_SECURE=0   # nur lokal ohne HTTPS
